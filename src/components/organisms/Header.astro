---
import Logo from '../atoms/Logo.astro';
import NavLink from '../atoms/NavLink.astro';
---
<header
	id="main-header"
	class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/0 backdrop-blur-none border-b border-transparent"
>
	<div
		class="mx-auto max-w-4xl px-6 py-6 flex items-center justify-between"
	>
		<Logo href="#hero">Carlos Daniel</Logo>
		<nav class="flex items-center gap-8">
			<NavLink href="#projects">Projects</NavLink>
			<NavLink href="#experience">Experience</NavLink>
			<NavLink href="#writing">Writing</NavLink>
			<NavLink href="#contact">Contact</NavLink>
		</nav>
	</div>
	<!-- Animated bottom border via JS opacity -->
	<div
		id="header-border"
		class="absolute bottom-0 left-0 right-0 h-px bg-neutral-200 opacity-0 transition-opacity duration-300"
	>
	</div>
</header>

<script>
	// Header Scroll Effect
	const header = document.getElementById("main-header");
	const headerBorder = document.getElementById("header-border");

	window.addEventListener("scroll", () => {
		if (window.scrollY > 50) {
			header?.classList.replace("bg-white/0", "bg-white/80");
			header?.classList.replace("backdrop-blur-none", "backdrop-blur-md");
			if (headerBorder) headerBorder.style.opacity = "0.6";
		} else {
			header?.classList.replace("bg-white/80", "bg-white/0");
			header?.classList.replace("backdrop-blur-md", "backdrop-blur-none");
			if (headerBorder) headerBorder.style.opacity = "0";
		}
	});
</script>
