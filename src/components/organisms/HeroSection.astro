---
import Button from '../atoms/Button.astro';

const proof = [
  { label: 'Most recently', title: 'NiCE, Knowledge Management', detail: 'Production RAG on AWS Bedrock' },
  { label: 'Before that', title: 'Symmetry Club', detail: 'Led a mobile app to 180K+ users' },
  { label: 'Recognition', title: 'Two hackathon wins', detail: 'CochaTech and Paseo Aranjuez' },
];
---

<section id="hero" class="pt-36 sm:pt-44 pb-16">
  <div class="max-w-3xl">
    <p class="gsap-hero-item flex items-center gap-2.5 text-sm text-ink-soft mb-8">
      <span aria-hidden="true" class="size-2 rounded-full bg-available"></span>
      Open to full-time roles · La Paz, Bolivia · English &amp; Spanish
    </p>

    <h1 class="gsap-hero-item font-serif text-5xl sm:text-6xl lg:text-[4.25rem] font-normal text-ink leading-[1.05] tracking-tight mb-7 text-balance">
      Backend and AI engineer building production RAG and real-time systems.
    </h1>

    <p class="gsap-hero-item text-lg sm:text-xl text-ink-soft leading-relaxed max-w-2xl mb-10">
      I have shipped generative search at enterprise scale and a consumer app used by 180K+ people. I care about systems that stay correct when the code around them is wrong.
    </p>

    <div class="gsap-hero-item flex flex-wrap items-center gap-x-7 gap-y-4">
      <Button href="mailto:carlos.daniel.development@gmail.com" size="lg">Email me</Button>
      <a href="#projects" class="text-base font-medium text-ink underline underline-offset-[5px] decoration-rule hover:decoration-ink transition-colors">
        See selected work ↓
      </a>
    </div>
  </div>

  <dl class="gsap-hero-item mt-20 grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-12 py-9 border-y border-rule">
    {proof.map((p) => (
      <div>
        <dt class="text-[13px] text-muted mb-2">{p.label}</dt>
        <dd>
          <span class="block font-serif text-[22px] leading-snug text-ink">{p.title}</span>
          <span class="block text-sm text-ink-soft mt-1.5">{p.detail}</span>
        </dd>
      </div>
    ))}
  </dl>
</section>
