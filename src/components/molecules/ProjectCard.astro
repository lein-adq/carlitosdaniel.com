---
interface Props {
	title: string;
	/** Omit while the case study doesn't exist yet; the card renders unlinked. */
	href?: string;
	year: string;
	description: string;
	tags: string[];
}

const { title, href, year, description, tags } = Astro.props;

const VisualTag = href ? "a" : "div";
const TitleTag = href ? "a" : "span";
---

<div class="gsap-project-item group">
	<!-- Project Visual Placeholder -->
	<VisualTag
		href={href}
		aria-label={href ? `View case study: ${title}` : undefined}
		class:list={[
			"block mb-8 overflow-hidden rounded-xl bg-neutral-100 border border-neutral-200 aspect-video relative flex items-center justify-center text-neutral-400 transition-colors",
			href && "project-image-hover group-hover:border-neutral-300 cursor-none focus-visible:ring-2 focus-visible:ring-neutral-900 focus-visible:ring-offset-2",
		]}
	>
		<div
			class="absolute inset-0 bg-neutral-900/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"
		>
		</div>
		<div
			class="flex flex-col items-center z-0 transition-transform duration-500 group-hover:scale-105"
		>
			<slot name="icon" />
			<span class="text-xs font-mono"><slot name="placeholder-text" /></span>
		</div>
	</VisualTag>

	<div
		class="flex flex-col md:flex-row md:justify-between md:items-baseline mb-3 px-1"
	>
		<h3 class="text-xl font-medium text-neutral-900">
			<TitleTag
				href={href}
				class:list={[
					href && "hover:underline decoration-neutral-300 underline-offset-4 focus:outline-none focus-visible:underline",
				]}
			>
				{title}
			</TitleTag>
			{!href && <span class="ml-3 text-xs font-mono text-neutral-400">Case study coming soon</span>}
		</h3>
		<span class="text-xs font-mono tracking-wide text-neutral-400 mt-1 md:mt-0"
			>{year}</span
		>
	</div>
	<p class="text-sm text-neutral-600 leading-relaxed max-w-2xl mb-4 px-1">
		{description}
	</p>
	<div class="flex gap-2 text-xs font-mono text-neutral-500 px-1">
		{tags.map((tag, index) => {
			if (tags.length === 1) return <span>[ {tag} ]</span>;
			if (index === 0) return <span>[ {tag}</span>;
			if (index === tags.length - 1) return <span>{tag} ]</span>;
			return <span>{tag}</span>;
		})}
	</div>
</div>
