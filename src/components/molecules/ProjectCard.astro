---
interface Props {
	title: string;
	/** Omit while the case study doesn't exist yet; the card then shows only the source link. */
	href?: string;
	/** Public source repository. */
	repo?: string;
	year: string;
	description: string;
	/** One skimmable sentence on what the project proves. */
	why: string;
	stack: string[];
}

const { title, href, repo, year, description, why, stack } = Astro.props;
---

<article class="gsap-project-item flex flex-col md:flex-row gap-x-12 gap-y-4 py-10 border-t border-rule last:border-b">
	<div class="md:w-24 shrink-0 text-sm text-muted md:pt-2">{year}</div>

	<div class="min-w-0 flex-1">
		<h3 class="font-serif text-[1.75rem] sm:text-[2rem] leading-tight font-medium tracking-tight text-ink mb-3">
			{href ? (
				<a href={href} class="hover:text-link transition-colors focus:outline-none focus-visible:underline underline-offset-4">{title}</a>
			) : (
				title
			)}
		</h3>
		<p class="text-base text-ink-soft leading-relaxed max-w-xl mb-3.5">{description}</p>
		<p class="text-base text-ink leading-relaxed max-w-xl mb-5">
			<strong class="font-semibold">Why it matters:</strong> {why}
		</p>
		<p class="text-sm text-muted">{stack.join(" · ")}</p>
	</div>

	<div class="flex md:flex-col gap-x-6 gap-y-2.5 text-sm font-medium md:pt-2 md:items-end">
		{href && (
			<a href={href} class="text-ink underline underline-offset-4 decoration-rule hover:decoration-ink transition-colors whitespace-nowrap">Read the case study →</a>
		)}
		{repo && (
			<a href={repo} target="_blank" rel="noopener noreferrer" class="text-ink underline underline-offset-4 decoration-rule hover:decoration-ink transition-colors whitespace-nowrap">Source on GitHub ↗</a>
		)}
	</div>
</article>
