---
interface Props {
	quote: string;
	name: string;
	role: string;
}

const { quote, name, role } = Astro.props;
---

<div
	class="gsap-project-item p-8 rounded-2xl bg-ink/5 border border-rule flex flex-col justify-between"
>
	<p class="text-sm text-ink-soft leading-relaxed mb-8 italic">
		"{quote}"
	</p>
	<div class="flex items-center gap-4">
		<div class="w-10 h-10 rounded-full bg-rule shrink-0"></div>
		<div>
			<div class="text-sm font-medium text-ink">{name}</div>
			<div class="text-xs text-muted font-mono">{role}</div>
		</div>
	</div>
</div>
