---
interface Props {
	quote: string;
	name: string;
	role: string;
}

const { quote, name, role } = Astro.props;
---

<div
	class="gsap-project-item p-8 rounded-2xl bg-neutral-50 border border-neutral-100 flex flex-col justify-between"
>
	<p class="text-sm text-neutral-700 leading-relaxed mb-8 italic">
		"{quote}"
	</p>
	<div class="flex items-center gap-4">
		<div class="w-10 h-10 rounded-full bg-neutral-200 shrink-0"></div>
		<div>
			<div class="text-sm font-medium text-neutral-900">{name}</div>
			<div class="text-xs text-neutral-500 font-mono">{role}</div>
		</div>
	</div>
</div>
