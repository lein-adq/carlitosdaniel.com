---
interface Props {
	role: string;
	period: string;
	company: string;
	description: string;
}

const { role, period, company, description } = Astro.props;
---

<div class="gsap-project-item">
	<div
		class="flex flex-col md:flex-row md:justify-between md:items-baseline mb-2"
	>
		<h3 class="text-base font-medium text-neutral-900">{role}</h3>
		<span class="text-xs font-mono tracking-wide text-neutral-400"
			>{period}</span
		>
	</div>
	<div class="text-sm text-neutral-500 font-mono tracking-wide mb-4">
		{company}
	</div>
	<p class="text-sm text-neutral-600 leading-relaxed max-w-2xl">
		{description}
	</p>
</div>
