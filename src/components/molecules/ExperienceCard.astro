---
interface Props {
	role: string;
	period: string;
	company: string;
	location?: string;
	description: string;
	/** The first few show by default; the rest sit behind a native disclosure. */
	highlights?: string[];
	visibleHighlights?: number;
}

const {
	role,
	period,
	company,
	location,
	description,
	highlights = [],
	visibleHighlights = 3,
} = Astro.props;

const shown = highlights.slice(0, visibleHighlights);
const more = highlights.slice(visibleHighlights);
const moreId = `exp-more-${`${company}-${period}`.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<article class="gsap-project-item flex flex-col md:flex-row gap-x-12 gap-y-4 py-10 border-t border-rule last:border-b">
	<div class="md:w-52 shrink-0 text-sm leading-relaxed text-muted md:pt-1.5">
		<div>{period}</div>
		{location && <div>{location}</div>}
	</div>

	<div class="min-w-0 flex-1 max-w-2xl">
		<h3 class="font-serif text-[1.75rem] font-medium tracking-tight text-ink leading-tight">{role}, {company}</h3>
		<p class="text-sm text-muted mt-1 mb-5 leading-relaxed">{description}</p>

		<ul class="list-disc space-y-2.5 pl-5 text-base text-ink-soft leading-relaxed marker:text-muted">
			{shown.map((item) => <li>{item}</li>)}
		</ul>

		{more.length > 0 && (
			<div data-expandable class="mt-4">
				<button
					type="button"
					data-expand
					aria-expanded="false"
					aria-controls={moreId}
					class="exp-toggle"
				>
					Show {more.length} more
				</button>
				<div id={moreId} data-more tabindex="-1" class="exp-more hidden outline-none">
					<ul class="list-disc space-y-2.5 pl-5 text-base text-ink-soft leading-relaxed marker:text-muted">
						{more.map((item) => <li>{item}</li>)}
					</ul>
					<button
						type="button"
						data-collapse
						aria-controls={moreId}
						class="exp-toggle mt-5"
					>
						Show less
					</button>
				</div>
			</div>
		)}
	</div>
</article>

<noscript>
	<style>
		.exp-more { display: block !important; }
		[data-expand], [data-collapse] { display: none !important; }
	</style>
</noscript>

<style is:global>
	.exp-toggle {
		cursor: pointer;
		width: fit-content;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-ink);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-color: var(--color-rule);
		transition: text-decoration-color 0.2s;
	}
	.exp-toggle:hover { text-decoration-color: var(--color-ink); }
	.exp-toggle:focus-visible { outline: 2px solid var(--color-link); outline-offset: 4px; border-radius: 2px; }
	.exp-more:not(.hidden) { margin-top: 1rem; }
</style>

<script>
	// "Show N more" reveals the rest of the list and "Show less" sits below it, so the control
	// is always at the end of whatever you just read.
	document.addEventListener("click", (e) => {
		const btn = (e.target as Element).closest("[data-expand], [data-collapse]") as HTMLElement | null;
		if (!btn) return;
		const wrap = btn.closest("[data-expandable]")!;
		const expand = wrap.querySelector<HTMLButtonElement>("[data-expand]")!;
		const more = wrap.querySelector<HTMLElement>("[data-more]")!;
		const opening = btn.hasAttribute("data-expand");

		more.classList.toggle("hidden", !opening);
		expand.classList.toggle("hidden", opening);
		expand.setAttribute("aria-expanded", String(opening));

		if (opening) {
			more.focus({ preventScroll: true });
		} else {
			// The list just got shorter: keep the control you pressed from jumping out of view.
			expand.focus({ preventScroll: true });
			expand.scrollIntoView({ block: "nearest", behavior: "smooth" });
		}
	});
</script>
