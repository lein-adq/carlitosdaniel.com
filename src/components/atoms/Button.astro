---
interface Props {
	href: string;
	/** `primary` is the single high-contrast call to action; `inverse` is its twin on dark backgrounds. */
	variant?: "primary" | "inverse";
	size?: "md" | "lg";
	target?: string;
}

const { href, variant = "primary", size = "md", target } = Astro.props;

const base =
	"inline-flex items-center justify-center font-medium rounded-md transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2";
const sizes = {
	md: "px-5 py-2.5 text-sm",
	lg: "px-7 py-4 text-base",
};
const variants = {
	primary:
		"bg-ink text-paper hover:bg-link focus-visible:ring-ink focus-visible:ring-offset-paper",
	inverse:
		"bg-paper text-ink hover:bg-rule focus-visible:ring-paper focus-visible:ring-offset-ink",
};

const classes = `${base} ${sizes[size]} ${variants[variant]}`;
---

<a href={href} target={target} class={classes}>
	<slot />
</a>
