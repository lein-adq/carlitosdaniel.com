---
interface Props {
	href: string;
	variant?: "primary" | "secondary";
	target?: string;
}

const { href, variant = "primary", target } = Astro.props;

const baseClasses = "inline-flex items-center justify-center px-6 py-2.5 text-sm font-medium transition-all rounded-full hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-offset-2";
const primaryClasses = "text-white bg-neutral-900 hover:bg-neutral-800 focus:ring-neutral-900";
const secondaryClasses = "text-neutral-900 bg-white border border-neutral-200 hover:bg-neutral-50 focus:ring-neutral-200";

const classes = `${baseClasses} ${variant === "primary" ? primaryClasses : secondaryClasses}`;
---

<a href={href} target={target} class={classes}>
	<slot />
</a>
