---
import Layout from "./Layout.astro";
import Button from "../components/atoms/Button.astro";

const { frontmatter } = Astro.props;
const email = "carlos.daniel.development@gmail.com";

const site = Astro.site!;
const slug = Astro.url.pathname.split("/").filter(Boolean).pop()!;
const pageUrl = new URL(Astro.url.pathname, site).href;
const personId = `${site.href}#person`;

// Other case studies, for internal linking (skips this page and anything marked noindex).
const modules = import.meta.glob<{ frontmatter: Record<string, any> }>("../pages/work/*.mdx", { eager: true });
const others = Object.entries(modules)
	.map(([path, m]) => ({ slug: path.split("/").pop()!.replace(".mdx", ""), ...m.frontmatter }))
	.filter((p) => p.slug !== slug && !p.noindex);

const schema = [
	{
		"@type": "TechArticle",
		"@id": `${pageUrl}#article`,
		headline: frontmatter.title,
		description: frontmatter.description,
		url: pageUrl,
		mainEntityOfPage: pageUrl,
		image: new URL(`/og/${slug}.png`, site).href,
		author: { "@id": personId },
		publisher: { "@id": personId },
		isPartOf: { "@id": `${site.href}#website` },
		inLanguage: "en",
		keywords: frontmatter.stack.join(", "),
	},
	{
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Carlos Daniel", item: site.href },
			{ "@type": "ListItem", position: 2, name: frontmatter.title, item: pageUrl },
		],
	},
];
---

<Layout
	title={`${frontmatter.title} | Carlos Daniel`}
	description={frontmatter.description}
	image={`/og/${slug}.png`}
	imageAlt={`${frontmatter.title}, case study by Carlos Daniel`}
	type="article"
	noindex={Boolean(frontmatter.noindex)}
	schema={schema}
>
	<noscript><style>.reveal{opacity:1;transform:none}</style></noscript>
	<main id="main">
		<div class="max-w-3xl mx-auto px-6 pt-28 pb-24">
			<!-- Back link -->
			<div class="mb-14 reveal">
				<a
					href="/"
					class="text-sm text-ink-soft hover:text-ink transition-colors inline-flex items-center gap-2 group underline-offset-4 focus:outline-none focus-visible:underline"
				>
					<span class="transform group-hover:-translate-x-1 transition-transform"
						>←</span
					> Carlos Daniel
				</a>
			</div>

			<!-- Title and meta -->
			<header class="mb-16 reveal">
				<p class="text-sm text-muted mb-5">Case study · {frontmatter.timeline}</p>
				<h1 class="font-serif text-5xl sm:text-6xl font-normal tracking-tight leading-[1.05] mb-6 text-ink text-balance">
					{frontmatter.title}
				</h1>
				<p class="text-lg sm:text-xl leading-relaxed text-ink-soft mb-10">
					{frontmatter.description}
				</p>

				<dl class="flex flex-wrap gap-x-12 gap-y-6 border-y border-rule py-7">
					<div>
						<dt class="text-[13px] text-muted mb-1.5">Role</dt>
						<dd class="text-base font-medium text-ink">{frontmatter.role}</dd>
					</div>
					<div>
						<dt class="text-[13px] text-muted mb-1.5">Timeline</dt>
						<dd class="text-base font-medium text-ink">{frontmatter.timeline}</dd>
					</div>
					<div class="min-w-0 flex-1 basis-64">
						<dt class="text-[13px] text-muted mb-1.5">Stack</dt>
						<dd class="text-base font-medium text-ink">{frontmatter.stack.join(", ")}</dd>
					</div>
				</dl>
			</header>

			<!-- The Article -->
			<article class="text-lg leading-[1.75] text-ink-soft reveal mdx-content">
				<slot />
			</article>
		</div>

		{others.length > 0 && (
			<nav aria-labelledby="more-work" class="max-w-3xl mx-auto px-6 pb-20">
				<h2 id="more-work" class="font-serif text-2xl text-ink mb-6">More case studies</h2>
				<ul class="border-t border-rule">
					{others.map((o) => (
						<li class="border-b border-rule">
							<a href={`/work/${o.slug}/`} class="block py-5 group">
								<span class="block font-serif text-xl text-ink group-hover:text-link transition-colors">{o.title}</span>
								<span class="block text-sm text-ink-soft mt-1">{o.description}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		)}

		<!-- Closing call to action -->
		<section class="bg-ink text-paper">
			<div class="max-w-3xl mx-auto px-6 py-16 sm:py-20 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">
				<h2 class="font-serif text-3xl sm:text-4xl font-normal tracking-tight leading-[1.15] text-paper max-w-md">
					Want this kind of engineering on your team?
				</h2>
				<div class="shrink-0">
					<Button href={`mailto:${email}`} variant="inverse" size="lg">Email me</Button>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style is:global>
	@reference "../styles/global.css";

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* MDX Content Styles */
	.mdx-content h2 {
		@apply font-serif text-3xl font-medium tracking-tight mb-5 text-ink mt-14;
	}
	.mdx-content p {
		@apply mb-6;
	}
	.mdx-content a {
		@apply text-ink underline underline-offset-4 decoration-rule hover:decoration-ink transition-colors;
	}
	.mdx-content ul {
		@apply space-y-3 list-disc pl-5 my-8 marker:text-muted;
	}
	.mdx-content li strong {
		@apply text-ink font-semibold;
	}
	.mdx-content pre {
		@apply bg-[#0a0a0a] text-slate-200 p-6 rounded-lg overflow-x-auto font-mono text-sm shadow-xl my-8;
	}
	.mdx-content code {
		@apply bg-ink/5 px-1.5 py-0.5 rounded text-sm font-mono text-ink;
	}
	.mdx-content pre code {
		@apply bg-transparent p-0 text-inherit;
	}
</style>

<script>
	const setupReveals = () => {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ rootMargin: "0px", threshold: 0.1 },
		);

		document
			.querySelectorAll(".reveal")
			.forEach((elem) => observer.observe(elem));
	};
	setupReveals();
	document.addEventListener("astro:page-load", setupReveals);
</script>
