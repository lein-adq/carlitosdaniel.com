---
import Layout from '../layouts/Layout.astro';
import Section from '../components/organisms/Section.astro';
import ProjectCard from '../components/molecules/ProjectCard.astro';
import ExperienceCard from '../components/molecules/ExperienceCard.astro';
import HeroSection from '../components/organisms/HeroSection.astro';
import Button from '../components/atoms/Button.astro';

const email = "carlos.daniel.development@gmail.com";
---

<Layout
	title="Carlos Daniel: Backend & AI Engineer (RAG, Real-Time Systems)"
	description="Backend and AI engineer in Cochabamba, Bolivia. I build production RAG systems on AWS Bedrock and real-time backends, and I am open to full-time roles."
>
	<main id="main">
		<div class="max-w-5xl mx-auto px-6">
			<HeroSection />

			<Section
				id="projects"
				title="Selected work"
				subtitle="Three projects, each built around a constraint that had to hold."
			>
				<ProjectCard
					title="FormCore, a multi-tenant form backend"
					href="/work/formcore"
					repo="https://github.com/lein-adq/form_submission_service"
					year="2025"
					description="Workspace tenancy and JWT auth, where Postgres row-level security, not application code, decides who can see which rows."
					why="data isolation holds even if the application has a bug."
					stack={["Python", "FastAPI", "PostgreSQL"]}
				/>

				<ProjectCard
					title="Centinela, an enterprise RAG microservice"
					href="/work/centinela"
					repo="https://github.com/lein-adq/knowledge-service"
					year="2026"
					description="Vector search over business policies and audit logs, with LangChain, HuggingFace embeddings and pgvector kept behind hexagonal ports."
					why="the embedding model and vector store can be swapped without touching business logic."
					stack={["Python", "FastAPI", "LangChain", "pgvector"]}
				/>

				<ProjectCard
					title="Multiplayer Texas Hold'em"
					href="/work/poker"
					repo="https://github.com/lein-adq/poker"
					year="2026"
					description="A real-time game on .NET and SignalR with Redis and the Ory identity stack, backed by 611 backend tests and an end-to-end suite."
					why="each player only ever receives the cards they are allowed to see, and chips are never created or lost."
					stack={[".NET", "SignalR", "React", "Redis", "Ory Kratos"]}
				/>
			</Section>

			<Section id="experience" title="Experience">
				<ExperienceCard
					role="Software Engineer"
					period="June 2025 to July 2026"
					company="NiCE"
					location="Cochabamba, Bolivia"
					description="NiCE Knowledge Management is an enterprise platform where support teams publish help content and customers find answers through search and generative AI. I worked across the platform, AI, support and editor teams."
					highlights={[
						"Worked on a production RAG platform for generative search on AWS Bedrock (Claude and Amazon Nova), with permission-aware retrieval over Qdrant, per-site vector partitions and SageMaker embeddings.",
						"Cut search-analytics query latency from an 8,600ms peak average toward a sub-2s target by replacing per-document Painless scripts with filter aggregations, and added timeouts and partial-result guards.",
						"Closed a CSRF vulnerability (CWE-352) found in a penetration test and remediated stored-XSS findings across all customer tenants.",
						"Worked on automated answer-quality evaluation: an LLM-as-judge service scoring Faithfulness and Response Relevancy with RAGAS, run asynchronously on a sample of live completions so quality and hallucination checks add no request latency.",
						"Worked with the guardrails that run before the model: PII detection, prompt-injection normalization, rate limiting, and grounded-only prompts that return no answer when retrieval finds no content.",
						"Worked with token-streaming generation over SSE, with OpenTelemetry and Datadog instrumentation of retrieval and generation used to triage latency in production.",
						"Evaluated the ColPali vision-language retrieval approach against lightweight BGE-small embeddings and recommended the faster option on latency grounds.",
						"Eliminated duplicate publish and unpublish operations under a 1,000-concurrent-job load test using idempotent requests, and recovered stranded customer event data by fixing the dead-letter-queue replay pipeline.",
					]}
				/>

				<ExperienceCard
					role="Software Developer"
					period="April 2023 to June 2025"
					company="Symmetry Club"
					location="Delaware, United States"
					description="Consumer fitness app on the App Store and Play Store that offers personalized, AI-generated workout plans."
					highlights={[
						"Led development of a mobile app from the ground up to 180K+ users and $50K+ in revenue.",
						"Built a vertical AI agent that generates personalized workout plans, plus internal context-engineering tooling that accelerated development.",
						"Migrated infrastructure from Heroku to Google Cloud (Cloud Run, Cloud SQL, VPC), improving scalability and cost efficiency.",
						"Built scalable REST APIs with Django, PostgreSQL and Cloud SQL, serving millions of requests at high availability.",
						"Built CI/CD pipelines with GitHub Actions and Fastlane, cutting build and deploy times by 60% and enabling zero-downtime releases.",
						"Designed the frontend as a Clean Architecture modular monorepo so 7+ engineers could ship concurrently, and created a custom A/B-testing framework.",
					]}
				/>
			</Section>
		</div>

		<!-- Contact band: the page's closing call to action -->
		<section id="contact" class="mt-16 sm:mt-20 bg-ink text-paper scroll-mt-0">
			<div class="max-w-5xl mx-auto px-6 py-20 sm:py-24 flex flex-col md:flex-row md:items-center md:justify-between gap-10 md:gap-16">
				<div class="max-w-xl">
					<h2 class="font-serif text-4xl sm:text-5xl font-normal tracking-tight leading-[1.1] text-paper mb-4">
						Hiring for an AI or backend role?
					</h2>
					<p class="text-lg text-paper/80 leading-relaxed">
						I reply to every message. Tell me about the team and the problem, and I will tell you where I can help.
					</p>
				</div>
				<div class="flex flex-col items-start gap-4 shrink-0">
					<Button href={`mailto:${email}`} variant="inverse" size="lg">Email me</Button>
					<a href={`mailto:${email}`} class="text-sm text-paper/80 hover:text-paper transition-colors underline underline-offset-4 decoration-paper/30">{email}</a>
				</div>
			</div>
		</section>

		<footer class="max-w-5xl mx-auto px-6 py-8 text-[13px] text-muted">
			&copy; {new Date().getFullYear()} Carlos Daniel
		</footer>
	</main>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.addEventListener('DOMContentLoaded', () => {
		// Leave everything visible and static for users who ask for less motion.
		if (prefersReducedMotion) return;

		// Hero stagger
		gsap.set('.gsap-hero-item', { opacity: 0, y: 20 });
		gsap.to('.gsap-hero-item', {
			opacity: 1,
			y: 0,
			duration: 0.8,
			ease: 'power2.out',
			stagger: 0.15,
			delay: 0.2,
		});

		// Project and experience rows reveal once as they scroll into view
		document.querySelectorAll('.gsap-project-item').forEach((item) => {
			gsap.fromTo(
				item,
				{ opacity: 0, y: 15 },
				{
					opacity: 1,
					y: 0,
					duration: 0.6,
					ease: 'power2.out',
					scrollTrigger: { trigger: item, start: 'top 90%', once: true },
				},
			);
		});
	});
</script>
