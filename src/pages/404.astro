---
import Layout from "../layouts/Layout.astro";
import Button from "../components/atoms/Button.astro";
---

<Layout title="Page not found | Carlos Daniel" noindex>
	<main id="main" class="max-w-5xl mx-auto px-6 min-h-screen flex flex-col justify-center">
		<p class="text-sm text-muted mb-6">404</p>
		<h1 class="font-serif text-5xl sm:text-6xl font-normal tracking-tight text-ink mb-6">
			This page doesn't exist.
		</h1>
		<p class="text-lg text-ink-soft max-w-xl mb-8">
			The link may be broken or the page may have moved.
		</p>
		<div>
			<Button href="/" size="lg">Back home</Button>
		</div>
	</main>
</Layout>
