---
import Layout from "../layouts/Layout.astro";
import Button from "../components/atoms/Button.astro";
---

<Layout title="Page not found | Carlos Daniel">
	<main id="main" class="max-w-4xl mx-auto px-6 min-h-screen flex flex-col justify-center">
		<p class="text-xs font-mono text-neutral-500 tracking-wide mb-6">404</p>
		<h1 class="text-5xl font-light tracking-tight text-neutral-900 mb-6">
			This page doesn't exist.
		</h1>
		<p class="text-sm text-neutral-600 max-w-xl mb-8">
			The link may be broken or the page may have moved.
		</p>
		<div>
			<Button href="/">Back home</Button>
		</div>
	</main>
</Layout>
